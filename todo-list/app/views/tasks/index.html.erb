<% if notice.present? %>
  <p style="color:green;"><%= notice %></p>
<% end %>

<h2 style="text-align:center; font-weight:normal; margin-bottom:16px;">To-Do</h2>

<% @pending_tasks.each do |task| %>
  <div style="background:white; padding:12px 16px; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center; border-radius:3px;">
    <span><%= task.title %></span>
    <span style="display:flex; align-items:center; gap:8px;">
      <%= link_to "✏️", edit_task_path(task), style: "text-decoration:none; font-size:16px;" %>
      <%= button_to "🗑", task, method: :delete,
          form: { style: "display:inline; margin:0;" },
          style: "background:none; border:none; cursor:pointer; font-size:16px; padding:0; line-height:1;",
          data: { turbo_confirm: "Delete?" } %>
    </span>
  </div>
<% end %>

<div style="text-align:center; margin:20px 0;">
  <%= link_to "New task", new_task_path,
      style: "background:#6abf2e; color:white; padding:10px 22px; border-radius:4px; text-decoration:none; font-size:14px; font-weight:bold;" %>
</div>

<h2 style="text-align:center; font-weight:normal; margin-bottom:16px;">Completed</h2>

<% @completed_tasks.each do |task| %>
  <div style="background:white; padding:12px 16px; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center; border-radius:3px;">
    <span><%= task.title %></span>
    <%= button_to "🗑", task, method: :delete,
        form: { style: "display:inline; margin:0;" },
        style: "background:none; border:none; cursor:pointer; font-size:16px; padding:0; line-height:1;",
        data: { turbo_confirm: "Delete?" } %>
  </div>
<% end %>