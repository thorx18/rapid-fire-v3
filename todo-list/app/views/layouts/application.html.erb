<!DOCTYPE html>
<html>
  <head>
    <title>Todo List</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body style="margin:0; font-family: Arial, sans-serif; background:#f0f0f0; min-height:100vh;">
    <div style="background:#111; color:white; padding:16px 20px; font-size:22px; font-weight:bold; width:100%; box-sizing:border-box;">iTasks</div>
    <div style="height:4px; background:#6abf2e; width:100%;"></div>
    <div style="max-width:560px; margin:30px auto; padding:0 20px;">
      <%= yield %>
    </div>
  </body>
</html>